# Fichier exemple pour .env
# Copiez ce fichier en .env et modifiez les valeurs

# === PostgreSQL ===
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION
POSTGRES_DB=mlflow

# === SeaweedFS (S3 compatible) ===
S3_ACCESS_KEY=mlflow_s3
S3_SECRET_KEY=CHANGEZ_MOI_EN_PRODUCTION
S3_BUCKET=mlflow-artifacts

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000
