# Fichier exemple pour .env
# Copiez ce fichier en .env et modifiez les valeurs

# === PostgreSQL ===
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION
POSTGRES_DB=mlflow

# === MinIO (S3 compatible) ===
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=CHANGEZ_MOI_EN_PRODUCTION
MINIO_BUCKET=mlflow-artifacts

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000
